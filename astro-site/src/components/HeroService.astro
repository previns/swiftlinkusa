---
import InnerHero from "./InnerHero.astro";
/**
 * Service-page hero: video background + pill badge + headline (with accent span)
 * + subtitle + primary/secondary CTAs.
 *
 * Used by: ftl, ltl, drayage, expedited, heavy-haul, hazmat.
 */
interface CTA {
  href: string;
  text: string;
}

interface Props {
  videoSrc: string;
  /** Font Awesome icon for the pill badge (e.g. "fa-truck") */
  pillIcon: string;
  pillText: string;
  /** Plain text part of the headline */
  titleStart: string;
  /** Highlighted (orange) part of the headline */
  titleAccent: string;
  /** Optional plain text part after the accent */
  titleEnd?: string;
  subtitle: string;
  primaryCta: CTA;
  secondaryCta?: CTA;
  poster?: string;
}

const {
  videoSrc,
  pillIcon,
  pillText,
  titleStart,
  titleAccent,
  titleEnd,
  subtitle,
  primaryCta,
  secondaryCta,
  poster,
} = Astro.props;
---
<InnerHero eyebrow={pillText} title={titleStart} accent={[titleAccent,titleEnd].filter(Boolean).join(" ")} description={subtitle} icon={pillIcon} video={videoSrc} primaryHref={primaryCta.href} primaryLabel={primaryCta.text} />
