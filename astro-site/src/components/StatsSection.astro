---
const stats = [
  { value: "48", label: "States Served" },
  { value: "24/7", label: "Dispatch Coverage" },
  { value: "6", label: "Service Lines" },
  { value: "2 hrs", label: "Quote Response" },
];
---

<section class="py-20 bg-slate-950">
  <div class="max-w-7xl mx-auto px-6 text-center">
    <p class="text-orange-500 font-medium tracking-widest">OUR COMMITMENT</p>
    <h2 class="text-5xl font-bold tracking-tighter mt-3 mb-12">Service You Can Count On</h2>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-10">
      {
        stats.map((s) => (
          <div class="fade-in">
            <div class="stat-number text-orange-500">{s.value}</div>
            <p class="text-slate-400 mt-3 text-lg">{s.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
