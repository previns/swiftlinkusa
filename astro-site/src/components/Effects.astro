---
/**
 * Site-wide visual effects: scroll progress bar, staggered scroll reveals and the cursor
 * spotlight on cards. Styles live in styles/effects.css. Targets are picked by selector so
 * pages need no markup changes. Content that is already on screen when this runs is never
 * hidden (no flicker), and nothing is hidden at all for reduced-motion visitors or browsers
 * without IntersectionObserver.
 */
---

<script>
  const root = document.documentElement;
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Scroll progress.
  const bar = document.createElement("div");
  bar.className = "fx-progress";
  bar.setAttribute("aria-hidden", "true");
  document.body.append(bar);
  let ticking = false;
  const progress = () => {
    ticking = false;
    const max = root.scrollHeight - innerHeight;
    bar.style.transform = `scaleX(${max > 0 ? Math.min(1, scrollY / max) : 0})`;
  };
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(progress); } }, { passive: true });
  progress();

  // Cards that get the spotlight (and reveal).
  const CARDS = [
    ".editorial-section .grid > div.border", ".solution-buttons > button", ".solution-detail", ".journey-step",
    ".human-film", ".faq-item", "main .rounded-3xl.border:not(input,select,textarea)", "main .rounded-2xl.border:not(input,select,textarea)",
  ].join(",");
  // Other blocks that reveal on scroll.
  const BLOCKS = [
    "main h2", ".section-heading", ".editorial-section .text-center:has(h2)", ".editorial-section .grid > *",
    ".human-section > *", ".closing-section > *", "footer .grid > *", "footer .flex > div",
  ].join(",");
  const SKIP = ".connected-hero, .inner-hero, form, [data-no-fx], .page-jumps, .fixed";

  if (!reduce && "IntersectionObserver" in window) {
    const seen = new Set<HTMLElement>();
    const targets = Array.from(document.querySelectorAll<HTMLElement>(`${CARDS},${BLOCKS}`)).filter((el) => {
      if (el.closest(SKIP) || seen.has(el)) return false;
      // Skip children of something that is itself revealed, so blocks don't animate twice.
      for (let p = el.parentElement; p; p = p.parentElement) if (seen.has(p)) return false;
      seen.add(el);
      return true;
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        el.classList.add("fx-in");
        observer.unobserve(el);
        // Once settled, drop the reveal classes so the element's own hover transforms work again.
        el.addEventListener("transitionend", function done(e) {
          if (e.target !== el || e.propertyName !== "opacity") return;
          el.removeEventListener("transitionend", done);
          el.classList.remove("fx-reveal", "fx-in");
        });
      });
    }, { rootMargin: "0px 0px -8% 0px", threshold: 0.08 });
    const order = new Map<Element, number>();
    targets.forEach((el) => {
      if (el.getBoundingClientRect().top < innerHeight) return; // already visible: leave it alone
      const i = order.get(el.parentElement!) ?? 0;
      order.set(el.parentElement!, i + 1);
      el.style.setProperty("--fx-i", String(Math.min(i, 6)));
      el.classList.add("fx-reveal");
      observer.observe(el);
    });
    root.classList.add("fx");
  }

  // Night sky: faint twinkling stars plus white/gold streaks shooting across in all directions
  // (mostly diagonal) at mixed speeds, lengths and thicknesses, each fading in and out.
  if (!reduce) {
    const canvas = document.createElement("canvas");
    canvas.className = "fx-sky";
    canvas.setAttribute("aria-hidden", "true");
    document.body.append(canvas);
    const ctx = canvas.getContext("2d")!;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const GOLD = "201,162,39", PALE = "247,232,166", WHITE = "255,255,255";
    type Star = { x: number; y: number; r: number; a: number; speed: number; phase: number; c: string };
    type Streak = { x: number; y: number; dx: number; dy: number; len: number; w: number; a: number; life: number; age: number; c: string };
    let w = 0, h = 0, stars: Star[] = [], streaks: Streak[] = [], nextSpawn = 0, last = 0;
    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      w = innerWidth; h = innerHeight;
      canvas.width = w * dpr; canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const count = Math.round(Math.min(70, (w * h) / 22000));
      stars = Array.from({ length: count }, () => ({
        x: rand(0, w), y: rand(0, h), r: rand(0.4, 1.3), a: rand(0.12, 0.45), speed: rand(0.6, 2.2), phase: rand(0, 6.3),
        c: Math.random() < 0.22 ? PALE : WHITE,
      }));
    };
    const spawn = () => {
      // 70% travel on a diagonal band (either way); the rest go any direction.
      const diag = Math.random() < 0.7;
      const angle = diag ? (Math.random() < 0.5 ? rand(0.45, 0.85) : rand(2.3, 2.7)) + (Math.random() < 0.5 ? 0 : Math.PI) : rand(0, Math.PI * 2);
      const fast = Math.random() < 0.35;
      const speed = fast ? rand(700, 1300) : rand(90, 420);       // px per second
      const life = fast ? rand(0.45, 0.9) : rand(1.6, 4.2);        // seconds
      streaks.push({
        x: rand(-0.1, 1.1) * w, y: rand(-0.1, 1.1) * h, dx: Math.cos(angle) * speed, dy: Math.sin(angle) * speed,
        len: fast ? rand(140, 360) : rand(40, 170), w: rand(0.8, fast ? 2.4 : 1.7), a: rand(0.4, fast ? 0.95 : 0.65),
        life, age: 0, c: Math.random() < 0.45 ? GOLD : Math.random() < 0.5 ? PALE : WHITE,
      });
    };
    const frame = (t: number) => {
      const dt = Math.min(0.05, (t - last) / 1000 || 0); last = t;
      ctx.clearRect(0, 0, w, h);
      // The home page's "Pause animation" control pauses the sky too.
      if (root.classList.contains("motion-paused")) { streaks = []; requestAnimationFrame(frame); return; }
      const time = t / 1000;
      for (const s of stars) {
        const tw = 0.55 + 0.45 * Math.sin(time * s.speed + s.phase);
        ctx.fillStyle = `rgba(${s.c},${(s.a * tw).toFixed(3)})`;
        ctx.beginPath(); ctx.arc(s.x, s.y, s.r, 0, 6.283); ctx.fill();
      }
      if (time > nextSpawn && streaks.length < 18) { spawn(); nextSpawn = time + rand(0.12, 0.8); }
      streaks = streaks.filter((s) => (s.age += dt) < s.life);
      for (const s of streaks) {
        s.x += s.dx * dt; s.y += s.dy * dt;
        const p = s.age / s.life, fade = Math.sin(Math.PI * p);   // fade in, then out
        const sp = Math.hypot(s.dx, s.dy), tx = s.x - (s.dx / sp) * s.len, ty = s.y - (s.dy / sp) * s.len;
        const g = ctx.createLinearGradient(s.x, s.y, tx, ty);
        g.addColorStop(0, `rgba(${s.c},${(s.a * fade).toFixed(3)})`);
        g.addColorStop(1, `rgba(${s.c},0)`);
        ctx.strokeStyle = g; ctx.lineWidth = s.w; ctx.lineCap = "round";
        ctx.beginPath(); ctx.moveTo(s.x, s.y); ctx.lineTo(tx, ty); ctx.stroke();
        if (s.w > 1.1) { // brighter heads get a small glow
          ctx.fillStyle = `rgba(${s.c},${(s.a * fade * 0.6).toFixed(3)})`;
          ctx.beginPath(); ctx.arc(s.x, s.y, s.w * 1.4, 0, 6.283); ctx.fill();
        }
      }
      requestAnimationFrame(frame);
    };
    addEventListener("resize", resize);
    resize();
    requestAnimationFrame(frame);
  }

  // Spotlight follows the cursor on hover-capable devices.
  if (matchMedia("(hover: hover)").matches) {
    document.querySelectorAll<HTMLElement>(CARDS).forEach((el) => {
      if (el.closest(".connected-hero, .inner-hero")) return;
      if (getComputedStyle(el).position === "static") el.style.position = "relative";
      el.classList.add("fx-spot");
    });
    document.addEventListener("pointermove", (event) => {
      const card = (event.target as Element).closest<HTMLElement>(".fx-spot");
      if (!card) return;
      const r = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${event.clientX - r.left}px`);
      card.style.setProperty("--my", `${event.clientY - r.top}px`);
    }, { passive: true });
  }
</script>
