---
const reasons = [
  {
    icon: "fa-clock",
    title: "Thoughtful Planning",
    text: "Pickup requirements, delivery appointments, and equipment needs considered before your freight moves.",
  },
  {
    icon: "fa-eye",
    title: "Clear Communication",
    text: "Shipment updates and practical answers so you can plan the next step.",
  },
  {
    icon: "fa-handshake",
    title: "Dedicated Support",
    text: "A team you can contact about your shipment, from the initial request through delivery.",
  },
];
---

<section id="why-us" class="py-24 bg-slate-950">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <p class="text-orange-500 font-medium">WHY CHOOSE SWIFTLINK</p>
      <h2 class="text-3xl md:text-4xl font-bold tracking-tighter mt-3">Built for Reliability</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8">
      {
        reasons.map((r) => (
          <div class="text-center fade-in">
            <i class={`fa-solid ${r.icon} text-5xl text-orange-500 mb-6`} aria-hidden="true" />
            <h3 class="text-2xl font-semibold mb-3">{r.title}</h3>
            <p class="text-slate-400">{r.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
