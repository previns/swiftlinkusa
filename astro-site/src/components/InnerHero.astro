---
import Breadcrumbs from "./Breadcrumbs.astro";
interface Props { eyebrow:string; title:string; accent:string; description:string; icon?:string; video?:string; primaryHref?:string; primaryLabel?:string; }
const {eyebrow,title,accent,description,icon='fa-network-wired',video,primaryHref='/quote',primaryLabel='Plan your shipment'}=Astro.props;
---
<section class="inner-hero">
 <div class="inner-grid" aria-hidden="true"></div>
 <div class="connected-wrap inner-hero-layout">
  <div class="inner-copy"><Breadcrumbs /><p class="tech-label"><span class="signal"></span>{eyebrow}</p><h1>{title}<br /><span>{accent}</span></h1><p class="inner-description">{description}</p><div class="hero-actions"><a class="tech-button" href={primaryHref}>{primaryLabel} ↗</a><a href="#page-content" class="quiet-link">Explore below ↓</a></div></div>
  <div class="inner-display"><div class="display-top"><span>SWIFTLINK / {eyebrow}</span><span class="display-dot"></span></div>{video && <video class="inner-video" muted playsinline loop preload="none" poster={video.replace("/videos/", "/images/posters/").replace(".mp4", ".webp")} aria-hidden="true"><source data-src={video} type="video/mp4" /></video>}<div class="display-overlay"></div><div class="display-orbits" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit-core"><i class={`fa-solid ${icon}`}></i></div><span class="orbit-node"></span></div><div class="display-bottom"><span>PEOPLE. PLANNING. CONNECTION.</span><button type="button" data-inner-motion aria-pressed="false">Pause motion</button></div></div>
 </div>
</section>
<div id="page-content" class="page-content-anchor"></div>
<script>
 import { pauseMotionByDefault, playDecorativeVideo } from "../scripts/decorative-video";
 document.querySelectorAll<HTMLElement>('.inner-display').forEach(display=>{const button=display.querySelector<HTMLButtonElement>('[data-inner-motion]')!;const video=display.querySelector<HTMLVideoElement>('video');const preference=matchMedia('(prefers-reduced-motion: reduce)');let paused=pauseMotionByDefault();let visible=false;const update=()=>{display.classList.toggle('inner-paused',paused);button.textContent=paused?'Play motion':'Pause motion';button.setAttribute('aria-pressed',String(paused));if(video){if(paused||!visible)video.pause();else playDecorativeVideo(video);}};button.addEventListener('click',()=>{paused=!paused;update();});preference.addEventListener('change',()=>{paused=pauseMotionByDefault();update();});new IntersectionObserver(entries=>{visible=entries[0].isIntersecting;update();}).observe(display);update();});
</script>
