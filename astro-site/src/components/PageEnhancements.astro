<nav class="page-jumps connected-wrap" aria-label="On this page" hidden><span>ON THIS PAGE</span><div data-page-jumps></div></nav>
<script>
 const main=document.querySelector('main')!;
 if(location.pathname!=='/'){
  const nav=document.querySelector<HTMLElement>('.page-jumps')!;const links=nav.querySelector('[data-page-jumps]')!;
  Array.from(main.querySelectorAll<HTMLElement>('h2')).filter(h=>!h.closest('#successCard,[role="dialog"],.fixed,[data-no-jumps]')).slice(0,7).forEach((heading,i)=>{if(!heading.id)heading.id='page-section-'+i;const a=document.createElement('a');a.href='#'+heading.id;a.textContent=heading.textContent;links.append(a);});
  if(links.children.length){nav.hidden=false;const anchor=main.querySelector('#page-content');if(anchor)anchor.after(nav);else main.prepend(nav);}
  main.querySelectorAll('section').forEach(section=>{if(section.querySelector('h2')&&!section.classList.contains('inner-hero'))section.classList.add('editorial-section');});
 }
 const faqItems=Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));
 if(faqItems.length){const search=document.createElement('div');search.className='faq-search';search.innerHTML='<label for="faq-find">Find an answer</label><input id="faq-find" type="search" placeholder="Search pricing, shipping, tracking…" /><p role="status" aria-live="polite"></p>';const first=document.querySelector('[data-faq-section]')!;first.parentElement!.parentElement!.prepend(search);const field=search.querySelector('input')!;const status=search.querySelector('p')!;field.addEventListener('input',()=>{const value=field.value.toLowerCase().trim();let count=0;faqItems.forEach(item=>{item.hidden=!item.textContent!.toLowerCase().includes(value);if(!item.hidden)count++;});document.querySelectorAll('[data-faq-section]').forEach(section=>{(section.parentElement as HTMLElement).hidden=!Array.from(section.querySelectorAll<HTMLElement>('.faq-item')).some(item=>!item.hidden);});status.textContent=value?(count?count+' matching answers':'No matching answers. Try another term or contact our team.') : '';});}
 const quote=document.querySelector<HTMLFormElement>('#quoteForm');
 if(quote){const summary=document.createElement('div');summary.className='quote-route-summary';summary.innerHTML='<span>YOUR SHIPMENT PLAN</span><strong data-route-summary>Origin → Destination</strong><p data-type-summary>Full truckload · Tell us the details below</p>';quote.prepend(summary);const update=()=>{const origin=document.querySelector<HTMLInputElement>('#originInput')?.value.trim()||'Origin';const destination=document.querySelector<HTMLInputElement>('#destInput')?.value.trim()||'Destination';summary.querySelector('[data-route-summary]')!.textContent=origin+' → '+destination;summary.querySelector('[data-type-summary]')!.textContent=(document.querySelector<HTMLInputElement>('#serviceType')?.value||'FTL')+' · Shipment details';};quote.addEventListener('input',update);quote.addEventListener('click',()=>queueMicrotask(update));}
</script>
