---
/**
 * SwiftLink Logistics brand lockup (Rev 3), reversed for the site's dark navy surfaces:
 * left chevron and SWIFT white, LINK and the right chevron brand gold, LOGISTICS white.
 *
 * SWIFTLINK is Agency FB Bold and LOGISTICS is Inter Regular, outlined to paths so every visitor
 * sees the real wordmark whether or not Agency FB is installed. Generated from the brand package
 * (Branding/SwiftLink_Brand_Package/02-Logos-Print-Vector/horizontal_reverse.svg, no margin).
 * Pass `label` when the mark is not inside a link that already names it.
 */
interface Props {
  /** Height utility for the whole lockup, e.g. "h-9" (nav) or "h-11" (footer). */
  heightClass?: string;
  /** Accessible name; omit when a parent link already carries one. */
  label?: string;
}

const { heightClass = "h-9", label } = Astro.props;
---

