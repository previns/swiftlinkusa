---
import "../styles/global.css";
import "../styles/interior.css";
import "../styles/effects.css";
import "../styles/seo-content.css";
import PageEnhancements from "../components/PageEnhancements.astro";
import Effects from "../components/Effects.astro";
import SeoHead from "../components/SeoHead.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import StructuredData from "../components/StructuredData.astro";
import ShippingResources from "../components/ShippingResources.astro";
import { services } from "../data/services";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  keywords?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonicalPath, keywords, ogTitle, ogDescription, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      keywords={keywords}
      ogTitle={ogTitle}
      ogDescription={ogDescription}
      ogImage={ogImage}
      noindex={noindex}
    />
    <StructuredData title={title} description={description} canonicalPath={canonicalPath} />
    <slot name="head" />
  </head>
  <body data-page={canonicalPath} class="bg-slate-950 text-white font-sans overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:bg-orange-500 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg focus:font-semibold"
    >
      Skip to main content
    </a>

    <Nav />

    <main id="main">
      <slot />
      {services.some(service => canonicalPath === `/${service.slug}`) && <ShippingResources />}
      {canonicalPath !== "/" && !noindex && <PageEnhancements />}
    </main>

    <Footer />
    <Effects />

    <script>
      import { pauseMotionByDefault, playDecorativeVideo } from "../scripts/decorative-video";
      // Give decorative video a pause control and respect reduced-motion settings.
      const motionPreference = window.matchMedia("(prefers-reduced-motion: reduce)");
      document.querySelectorAll<HTMLElement>(".hero-video-container").forEach((container) => {
        const hero = container.parentElement;
        const videos = Array.from(container.querySelectorAll<HTMLVideoElement>("video"));
        if (!hero || videos.length === 0) return;
        let paused = pauseMotionByDefault();
        let visible = false;
        const button = document.createElement("button");
        button.type = "button";
        button.className = "absolute bottom-4 right-6 z-20 rounded-full border border-white/30 bg-slate-950/80 px-4 py-2 text-xs text-white hover:border-orange-500";
        const update = () => {
          hero.dataset.motionPaused = String(paused);
          button.textContent = paused ? "Play background video" : "Pause background video";
          videos.forEach((video) => {
            if (paused || !visible) video.pause();
            else if (videos.length === 1 || video.classList.contains("active")) playDecorativeVideo(video);
          });
        };
        button.addEventListener("click", () => { paused = !paused; update(); });
        motionPreference.addEventListener("change", () => { paused = pauseMotionByDefault(); update(); });
        new IntersectionObserver(entries => { visible = entries[0].isIntersecting; update(); }).observe(container);
        hero.append(button);
        update();
      });

      // Shared scroll-triggered fade-in observer (used by .fade-in everywhere).
      const animate = () => {
        const els = document.querySelectorAll<HTMLElement>(".fade-in");
        if (!("IntersectionObserver" in window) || els.length === 0) {
          els.forEach((el) => el.classList.add("visible"));
          return;
        }
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1 },
        );
        els.forEach((el) => observer.observe(el));
      };
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", animate);
      } else {
        animate();
      }
    </script>
  </body>
</html>
