---
import BaseLayout from "../layouts/BaseLayout.astro";

interface FaqItem { q: string; a: string; }
interface FaqSection { icon: string; title: string; items: FaqItem[]; }

const sections: FaqSection[] = [
  {
    "icon": "fa-info-circle",
    "title": "Working with SwiftLink",
    "items": [
      {
        "q": "What is SwiftLink Logistics?",
        "a": "SwiftLink Logistics, LLC is a Michigan-based freight brokerage. We connect shippers with carrier partners and help coordinate truckload, LTL, drayage, expedited, heavy haul, and hazardous materials shipments."
      },
      {
        "q": "What areas do you serve?",
        "a": "We coordinate freight across the contiguous United States. Share your origin, destination, and equipment needs so we can review carrier availability for your route."
      },
      {
        "q": "How do I get a freight quote?",
        "a": "Use our <a href=\"/quote\" class=\"text-orange-500 underline\">quote request form</a> with your route, freight details, and preferred dates. Our team will review the request and follow up with available options. Pricing and timing are confirmed before booking."
      },
      {
        "q": "How can I reach your team?",
        "a": "Call <a href=\"tel:+12489876776\" class=\"text-orange-500 underline\">(248) 987-6776</a> or email <a href=\"mailto:info@swiftlinkusa.com\" class=\"text-orange-500 underline\">info@swiftlinkusa.com</a>. For an existing shipment, include your reference number. For a time-sensitive request, include your required pickup and delivery times."
      }
    ]
  },
  {
    "icon": "fa-truck",
    "title": "Shipping & Services",
    "items": [
      {
        "q": "What is the difference between FTL and LTL?",
        "a": "Full truckload (FTL) reserves trailer space for your shipment. Less-than-truckload (LTL) shares trailer space with other shipments and can suit smaller, palletized freight. The right choice depends on the size, handling needs, timing, and route of your shipment."
      },
      {
        "q": "What is drayage?",
        "a": "Drayage moves containers between ports, rail ramps, and nearby facilities. We help coordinate container pickup, appointments, and returns with carrier partners. <a href=\"/drayage\" class=\"text-orange-500 underline\">Explore drayage services</a>."
      },
      {
        "q": "Do you offer expedited shipping?",
        "a": "We review dedicated vehicle and team-driver options for time-sensitive freight. Tell us your deadline so we can confirm available capacity and a feasible schedule. <a href=\"/expedited\" class=\"text-orange-500 underline\">Explore expedited freight</a>."
      },
      {
        "q": "Can you help with oversized freight?",
        "a": "Contact us with the load dimensions, weight, pickup and delivery locations, and loading requirements. These details help us review suitable equipment and route planning. <a href=\"/heavy-haul\" class=\"text-orange-500 underline\">Explore heavy haul</a>."
      },
      {
        "q": "Do you handle hazardous materials?",
        "a": "Contact us with your commodity details and shipment documentation so we can review carrier suitability and service availability before booking. <a href=\"/hazmat\" class=\"text-orange-500 underline\">Explore hazmat shipping</a>."
      }
    ]
  },
  {
    "icon": "fa-dollar-sign",
    "title": "Pricing & Preparation",
    "items": [
      {
        "q": "What details should I have ready?",
        "a": "Provide the pickup and delivery locations, commodity, weight, dimensions, packaging, and preferred dates. Include any appointment, temperature, loading, or special handling requirements."
      },
      {
        "q": "How is freight pricing determined?",
        "a": "Pricing depends on the route, freight size and weight, equipment, timing, available capacity, and any additional services. Accurate shipment details help us prepare a useful quote."
      },
      {
        "q": "How long is a quote valid?",
        "a": "Refer to the validity and service terms provided with your quote. Rates and capacity can change before booking, so contact our team when you are ready to proceed."
      },
      {
        "q": "Can you help with recurring shipments?",
        "a": "Share your regular lanes, expected shipping frequency, and equipment requirements. We can discuss options that fit your shipping pattern."
      }
    ]
  },
  {
    "icon": "fa-location-crosshairs",
    "title": "Shipment Support",
    "items": [
      {
        "q": "How do I get a shipment update?",
        "a": "Contact our team with your shipment reference for pickup progress, transit updates, or estimated delivery timing. Available tracking options depend on the carrier and service."
      },
      {
        "q": "What if my schedule changes?",
        "a": "Let us know as soon as possible. We will review the change with the carrier and explain any effect on availability, timing, or pricing."
      },
      {
        "q": "Who should I contact about a delivery issue?",
        "a": "Contact your SwiftLink representative with your shipment reference and a description of the issue. Include any relevant delivery records or photos so we can help coordinate the next steps."
      }
    ]
  }
];

// Keep search metadata aligned with the answers visitors can read.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: sections.flatMap(section => section.items.map(item => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a.replace(/<[^>]*>/g, "") },
  }))),
};
---

<BaseLayout
  title="FAQ • SwiftLink Logistics"
  description="Frequently asked questions about SwiftLink Logistics freight services, pricing, shipping, tracking, and more. Get answers to common 3PL logistics questions."
  keywords="freight FAQ, logistics questions, 3PL FAQ, shipping questions, FTL LTL FAQ, freight broker FAQ, hazmat shipping FAQ, drayage questions, SwiftLink Logistics FAQ"
  canonicalPath="/faq"
  ogTitle="FAQ | SwiftLink Logistics - Freight & Shipping Questions Answered"
  ogDescription="Get answers to common questions about freight shipping, pricing, tracking, and logistics services from SwiftLink Logistics."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} slot="head" />

  <!-- HERO -->
  <section class="relative bg-slate-900 border-b border-slate-800 py-20 overflow-hidden">
    <div class="hero-video-container" aria-hidden="true">
      <video class="hero-video" autoplay muted loop playsinline preload="metadata">
        <source src="/videos/faq.mp4" type="video/mp4" />
      </video>
    </div>
    <div class="hero-overlay" aria-hidden="true"></div>
    <div class="relative z-10 max-w-4xl mx-auto px-6 text-center">
      <span class="inline-flex items-center gap-2 bg-orange-500/10 border border-orange-500/30 text-orange-400 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
        <i class="fa-solid fa-circle-question" aria-hidden="true"></i> Support
      </span>
      <h1 class="text-5xl md:text-6xl font-bold tracking-tighter mb-4">Frequently Asked Questions</h1>
      <p class="text-slate-400 text-xl max-w-2xl mx-auto">Everything you need to know about shipping with SwiftLink Logistics. Can't find your answer? Contact our team directly.</p>
    </div>
  </section>

  <!-- FAQ CONTENT -->
  <section class="py-24 bg-slate-950">
    <div class="max-w-4xl mx-auto px-6">
      {sections.map((section, sIdx) => (
        <div class={`${sIdx === sections.length - 1 ? "mb-8" : "mb-16"} fade-in`}>
          <div class="flex items-center gap-3 mb-8">
            <div class="w-10 h-10 bg-orange-500/10 rounded-xl flex items-center justify-center">
              <i class={`fa-solid ${section.icon} text-orange-500`} aria-hidden="true"></i>
            </div>
            <h2 class="text-2xl font-bold">{section.title}</h2>
          </div>
          <div class="space-y-3" data-faq-section>
            {section.items.map((item, iIdx) => {
              const id = `faq-${sIdx}-${iIdx}`;
              return (
                <div class="faq-item bg-slate-900 border border-slate-800 rounded-xl overflow-hidden">
                  <button
                    type="button"
                    class="faq-trigger w-full flex justify-between items-center p-5 text-left hover:bg-slate-800/50 transition"
                    aria-expanded="false"
                    aria-controls={id}
                  >
                    <span class="font-semibold pr-4">{item.q}</span>
                    <i class="fa-solid fa-chevron-down text-orange-500 text-xs faq-chevron" aria-hidden="true"></i>
                  </button>
                  <div id={id} class="faq-answer px-5 text-slate-400 text-sm leading-relaxed" role="region">
                    <div class="pb-5" set:html={item.a} />
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-slate-900 border-t border-slate-800">
    <div class="max-w-4xl mx-auto px-6 text-center fade-in">
      <h2 class="text-3xl font-bold mb-4">Still Have Questions?</h2>
      <p class="text-slate-400 text-lg mb-8">Our team is ready to help. Reach out and we'll get you the answers you need.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="bg-orange-500 hover:bg-orange-600 px-10 py-4 rounded-2xl font-semibold text-lg transition inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-phone" aria-hidden="true"></i> Contact Us
        </a>
        <a href="/quote" class="border border-slate-700 hover:border-orange-500 px-10 py-4 rounded-2xl font-semibold text-lg transition inline-flex items-center justify-center gap-2">
          <i class="fa-solid fa-paper-plane" aria-hidden="true"></i> Get a Quote
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
  }
  .faq-answer.open {
    max-height: 600px;
  }
  .faq-chevron {
    transition: transform 0.3s ease;
  }
  .faq-chevron.open {
    transform: rotate(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-answer,
    .faq-chevron {
      transition: none;
    }
  }
</style>

<script>
  // FAQ accordion: one open per section, ARIA-aware.
  const triggers = document.querySelectorAll<HTMLButtonElement>(".faq-trigger");
  triggers.forEach((btn) => {
    btn.addEventListener("click", () => {
      const answer = btn.nextElementSibling as HTMLElement | null;
      const chevron = btn.querySelector<HTMLElement>(".faq-chevron");
      if (!answer) return;

      const isOpen = answer.classList.contains("open");
      const section = btn.closest("[data-faq-section]");

      // Close all in same section
      section?.querySelectorAll<HTMLElement>(".faq-answer.open").forEach((a) => {
        a.classList.remove("open");
        const prevBtn = a.previousElementSibling as HTMLButtonElement | null;
        prevBtn?.setAttribute("aria-expanded", "false");
        prevBtn?.querySelector(".faq-chevron")?.classList.remove("open");
      });

      if (!isOpen) {
        answer.classList.add("open");
        chevron?.classList.add("open");
        btn.setAttribute("aria-expanded", "true");
      }
    });
  });
</script>
