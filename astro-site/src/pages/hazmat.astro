---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroService from "../components/HeroService.astro";

const details = [
  { icon: "fa-flask", title: "Commodity details", text: "Share the material description, classification details, and available shipment documentation so we can review the request." },
  { icon: "fa-box", title: "Packaging & handling", text: "Tell us how the freight is packaged, its weight and dimensions, and any temperature or handling needs." },
  { icon: "fa-route", title: "Route & timing", text: "Include pickup and delivery locations, facility requirements, and preferred dates so we can assess available options." },
];
---
<BaseLayout
  title="Hazmat Shipping • SwiftLink Logistics"
  description="Discuss hazardous materials shipping with SwiftLink Logistics. Shipment-specific carrier and equipment coordination based on your commodity, route, and handling needs."
  canonicalPath="/hazmat"
>
  <HeroService
    videoSrc="/videos/hazmat.mp4"
    pillIcon="fa-biohazard"
    pillText="Specialized Freight"
    titleStart="Hazardous Materials"
    titleAccent="Shipping"
    subtitle="Careful planning starts with understanding your freight. Share your shipment details so we can review suitable carrier and equipment options."
    primaryCta={{ href: "/quote/?service=Hazmat", text: "Request a Hazmat Quote" }}
    secondaryCta={{ href: "/contact", text: "Talk with Our Team" }}
  />

  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-12 items-start">
      <div class="fade-in">
        <p class="text-orange-500 text-sm font-semibold tracking-widest uppercase mb-3">A considered approach</p>
        <h2 class="text-3xl md:text-4xl font-bold mb-6">Plan around the material.</h2>
        <p class="text-slate-300 text-lg leading-relaxed">Hazardous materials shipments need a plan that reflects the specific commodity, packaging, route, and receiving facility. Our team reviews these details with carrier partners before confirming service.</p>
      </div>
      <div class="fade-in bg-slate-900 border border-slate-800 rounded-2xl p-8">
        <h3 class="text-xl font-semibold mb-4">Start with a shipment review</h3>
        <p class="text-slate-400 leading-relaxed">Send us your freight details and available documentation. We’ll follow up with questions, discuss carrier availability, and confirm whether the requested service can be arranged.</p>
        <a href="/quote/?service=Hazmat" class="inline-flex mt-6 text-orange-400 font-semibold underline underline-offset-4">Share your shipment details</a>
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-900">
    <div class="max-w-7xl mx-auto px-6">
      <div class="max-w-2xl mb-10">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">What to include in your request</h2>
        <p class="text-slate-400">Clear information helps us assess the shipment and identify the next steps.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6">
        {details.map((detail) => (
          <div class="fade-in bg-slate-950 border border-slate-800 rounded-2xl p-8">
            <i class={`fa-solid ${detail.icon} text-orange-500 text-2xl mb-5`} aria-hidden="true" />
            <h3 class="text-xl font-semibold mb-3">{detail.title}</h3>
            <p class="text-slate-400 leading-relaxed">{detail.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-20 bg-slate-950">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold mb-5">Discuss your next shipment.</h2>
      <p class="text-slate-300 text-lg mb-8">We’ll review your material, route, and timing before confirming available shipping options.</p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/quote/?service=Hazmat" class="bg-orange-500 hover:bg-orange-600 px-8 py-4 rounded-2xl font-semibold transition">Request a Quote</a>
        <a href="tel:+12489876776" class="border border-slate-600 hover:border-orange-500 px-8 py-4 rounded-2xl font-semibold transition">Call (248) 987-6776</a>
      </div>
    </div>
  </section>
</BaseLayout>
